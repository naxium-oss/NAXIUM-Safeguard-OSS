[
  {
    "id": "sec-001",
    "label": "OpenAI API Key",
    "pattern": "sk-[A-Za-z0-9]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-001b",
    "label": "OpenAI Project API Key",
    "pattern": "sk-proj-[A-Za-z0-9_-]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-001c",
    "label": "Anthropic API Key",
    "pattern": "sk-ant-[A-Za-z0-9_-]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-001d",
    "label": "Stripe Secret Key",
    "pattern": "sk_(live|test)_[A-Za-z0-9]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-001e",
    "label": "npm Access Token",
    "pattern": "npm_[A-Za-z0-9]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-001f",
    "label": "OpenAI Service Account Key",
    "pattern": "sk-svcacct-[A-Za-z0-9_-]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-002",
    "label": "AWS Access Key",
    "pattern": "AKIA[0-9A-Z]{16}",
    "flags": "g"
  },
  {
    "id": "sec-002b",
    "label": "AWS Secret Access Key Assignment",
    "pattern": "(aws_secret_access_key|secretAccessKey)\\s*[=:]\\s*['\\\"]?[A-Za-z0-9/+=]{35,}",
    "flags": "gi"
  },
  {
    "id": "sec-003",
    "label": "GitHub Token",
    "pattern": "gh[pousr]_[A-Za-z0-9]{30,}",
    "flags": "g"
  },
  {
    "id": "sec-003b",
    "label": "GitHub Fine-grained PAT",
    "pattern": "github_pat_[A-Za-z0-9_]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-003c",
    "label": "Hugging Face Token",
    "pattern": "hf_[A-Za-z0-9]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-004",
    "label": "Slack Token",
    "pattern": "xox[baprs]-[A-Za-z0-9-]{10,}",
    "flags": "g"
  },
  {
    "id": "sec-004b",
    "label": "Slack Webhook",
    "pattern": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/_-]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-005",
    "label": "Google API Key",
    "pattern": "AIza[0-9A-Za-z\\-_]{35}",
    "flags": "g"
  },
  {
    "id": "sec-005b",
    "label": "Google OAuth Client Secret",
    "pattern": "GOCSPX-[A-Za-z0-9_-]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-006",
    "label": "Generic JWT",
    "pattern": "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
    "flags": "g"
  },
  {
    "id": "sec-007",
    "label": "Private Key Block",
    "pattern": "-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----",
    "flags": "g"
  },
  {
    "id": "sec-008",
    "label": "Azure Storage Connection String",
    "pattern": "DefaultEndpointsProtocol=https;AccountName=[^;]+;AccountKey=[A-Za-z0-9+/=]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-009",
    "label": "Azure SAS Token",
    "pattern": "[?&]sig=[A-Za-z0-9%+/=]{20,}",
    "flags": "gi"
  },
  {
    "id": "sec-010",
    "label": "Twilio Account SID",
    "pattern": "AC[a-f0-9]{32}",
    "flags": "g"
  },
  {
    "id": "sec-010b",
    "label": "Twilio Auth Token Assignment",
    "pattern": "(twilio[_-]?auth[_-]?token|auth_token)\\s*[=:]\\s*['\\\"]?[a-f0-9]{32}",
    "flags": "gi"
  },
  {
    "id": "sec-011",
    "label": "SendGrid API Key",
    "pattern": "SG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}",
    "flags": "g"
  },
  {
    "id": "sec-012",
    "label": "Discord Bot Token",
    "pattern": "[MN][A-Za-z0-9]{23,}\\.[A-Za-z0-9_-]{6}\\.[A-Za-z0-9_-]{27}",
    "flags": "g"
  },
  {
    "id": "sec-012b",
    "label": "Discord Webhook",
    "pattern": "https://discord(?:app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_-]+",
    "flags": "g"
  },
  {
    "id": "sec-013",
    "label": "Heroku API Key",
    "pattern": "heroku[_-]?api[_-]?key\\s*[=:]\\s*['\\\"]?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
    "flags": "gi"
  },
  {
    "id": "sec-014",
    "label": "Mailgun API Key",
    "pattern": "key-[0-9a-f]{32}",
    "flags": "g"
  },
  {
    "id": "sec-015",
    "label": "Mailchimp API Key",
    "pattern": "[0-9a-f]{32}-us\\d{1,2}",
    "flags": "g"
  },
  {
    "id": "sec-016",
    "label": "Shopify Access Token",
    "pattern": "shpat_[a-fA-F0-9]{32}",
    "flags": "g"
  },
  {
    "id": "sec-016b",
    "label": "Shopify Shared Secret",
    "pattern": "shpss_[a-fA-F0-9]{32}",
    "flags": "g"
  },
  {
    "id": "sec-017",
    "label": "Databricks Token",
    "pattern": "dapi[a-f0-9]{32}",
    "flags": "g"
  },
  {
    "id": "sec-018",
    "label": "DigitalOcean Token",
    "pattern": "dop_v1_[a-f0-9]{64}",
    "flags": "g"
  },
  {
    "id": "sec-019",
    "label": "PyPI Token",
    "pattern": "pypi-[A-Za-z0-9_-]{20,}",
    "flags": "g"
  },
  {
    "id": "sec-020",
    "label": "Telegram Bot Token",
    "pattern": "\\d{8,10}:[A-Za-z0-9_-]{35}",
    "flags": "g"
  },
  {
    "id": "sec-021",
    "label": "Square Access Token",
    "pattern": "sq0atp-[0-9A-Za-z\\-_]{22,}",
    "flags": "g"
  },
  {
    "id": "sec-022",
    "label": "PayPal Braintree Token",
    "pattern": "access_token\\$production\\$[0-9a-z]{16}\\$[0-9a-f]{32}",
    "flags": "g"
  },
  {
    "id": "sec-023",
    "label": "Firebase Cloud Messaging",
    "pattern": "AAAA[A-Za-z0-9_-]{7}:[A-Za-z0-9_-]{140,}",
    "flags": "g"
  },
  {
    "id": "sec-024",
    "label": "Postgres Connection URI",
    "pattern": "postgres(?:ql)?://[^\\s:]+:[^\\s@]+@[^\\s/]+",
    "flags": "gi"
  },
  {
    "id": "sec-025",
    "label": "MongoDB Connection URI",
    "pattern": "mongodb(?:\\+srv)?://[^\\s:]+:[^\\s@]+@[^\\s/]+",
    "flags": "gi"
  },
  {
    "id": "sec-026",
    "label": "Redis Connection URI",
    "pattern": "redis://[^\\s:]+:[^\\s@]+@[^\\s/]+",
    "flags": "gi"
  },
  {
    "id": "sec-027",
    "label": "Generic Bearer Token",
    "pattern": "bearer\\s+[A-Za-z0-9\\-._~+/]+=*",
    "flags": "gi"
  },
  {
    "id": "sec-028",
    "label": "Generic API Key Assignment",
    "pattern": "(api[_-]?key|apikey|access[_-]?token|secret[_-]?key)\\s*[=:]\\s*['\\\"]?[A-Za-z0-9_\\-]{16,}",
    "flags": "gi"
  }
]
